  format        String   @default("html")
  metrics       Json     @default("{}")
  hasNarratives Boolean  @default(false) @map("has_narratives")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("reports")
}

