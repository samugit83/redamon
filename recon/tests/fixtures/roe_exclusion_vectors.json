{
  "_comment": "Shared vectors for the RoE excluded-host matcher: recon/helpers/roe_scope.py _is_roe_excluded (recon/tests/test_roe_exclusion_vectors.py) and its TS copy webapp/src/lib/roeScope.ts isRoeExcluded (webapp/src/lib/roeScope.test.ts). Reserved names and documentation ranges only (example.com, *.test, 192.0.2.0/24, 10.0.0.0/8, 2001:db8::/32).",
  "vectors": [
    {"name": "a wildcard excludes a subdomain", "host": "a.example.com", "excluded": ["*.example.com"], "result": true},
    {"name": "a wildcard excludes a deep subdomain", "host": "x.y.example.com", "excluded": ["*.example.com"], "result": true},
    {"name": "a wildcard does not exclude its apex", "host": "example.com", "excluded": ["*.example.com"], "result": false},
    {"name": "a wildcard entry is normalised", "host": "a.example.com", "excluded": ["*.EXAMPLE.com."], "result": true},
    {"name": "a bare wildcard excludes nothing", "host": "a.example.com", "excluded": ["*."], "result": false},
    {"name": "a domain excludes itself", "host": "example.com", "excluded": ["example.com"], "result": true},
    {"name": "a domain excludes its subdomains", "host": "pay.example.com", "excluded": ["example.com"], "result": true},
    {"name": "a domain is not a string suffix", "host": "notexample.com", "excluded": ["example.com"], "result": false},
    {"name": "case is ignored on the host", "host": "API.Example.com", "excluded": ["api.example.com"], "result": true},
    {"name": "case is ignored on the entry", "host": "api.example.com", "excluded": ["API.EXAMPLE.COM"], "result": true},
    {"name": "a port on the host is ignored", "host": "api.example.com:8443", "excluded": ["api.example.com"], "result": true},
    {"name": "a port on the entry is ignored", "host": "api.example.com", "excluded": ["api.example.com:443"], "result": true},
    {"name": "a URL host is reduced to its hostname", "host": "https://api.example.com/x?y=1", "excluded": ["api.example.com"], "result": true},
    {"name": "a URL host with credentials and a port", "host": "https://user:pw@api.example.com:8443/x", "excluded": ["api.example.com"], "result": true},
    {"name": "a URL entry is reduced to its hostname", "host": "a.example.com", "excluded": ["https://example.com/login"], "result": true},
    {"name": "a trailing dot is ignored", "host": "api.example.com.", "excluded": ["api.example.com"], "result": true},
    {"name": "surrounding whitespace is ignored", "host": "  a.example.com  ", "excluded": ["  example.com "], "result": true},
    {"name": "an exact IPv4", "host": "192.0.2.10", "excluded": ["192.0.2.10"], "result": true},
    {"name": "another IPv4", "host": "192.0.2.10", "excluded": ["192.0.2.1"], "result": false},
    {"name": "an IPv4 with a port", "host": "192.0.2.10:8080", "excluded": ["192.0.2.10"], "result": true},
    {"name": "a string suffix is not an IP rule", "host": "10.0.0.5", "excluded": ["0.5"], "result": false},
    {"name": "a domain entry never matches an IP", "host": "192.0.2.10", "excluded": ["example.com"], "result": false},
    {"name": "an IPv4 CIDR", "host": "10.0.0.5", "excluded": ["10.0.0.0/24"], "result": true},
    {"name": "outside an IPv4 CIDR", "host": "10.0.1.5", "excluded": ["10.0.0.0/24"], "result": false},
    {"name": "a CIDR with host bits set", "host": "10.0.0.9", "excluded": ["10.0.0.5/24"], "result": true},
    {"name": "a /0 covers every IPv4", "host": "192.0.2.77", "excluded": ["0.0.0.0/0"], "result": true},
    {"name": "an IPv4 netmask", "host": "10.0.0.7", "excluded": ["10.0.0.0/255.255.255.0"], "result": true},
    {"name": "an IPv4 hostmask", "host": "10.0.0.7", "excluded": ["10.0.0.0/0.0.0.255"], "result": true},
    {"name": "a prefix that is too long is not a network", "host": "10.0.0.1", "excluded": ["10.0.0.0/33"], "result": false},
    {"name": "a CIDR never matches a hostname", "host": "example.com", "excluded": ["10.0.0.0/8"], "result": false},
    {"name": "a leading-zero octet is not an IP", "host": "010.0.0.5", "excluded": ["10.0.0.0/8"], "result": false},
    {"name": "an IPv6 in brackets", "host": "[2001:db8::1]", "excluded": ["2001:db8::1"], "result": true},
    {"name": "an IPv6 in long form", "host": "2001:0db8:0:0:0:0:0:1", "excluded": ["2001:db8::1"], "result": true},
    {"name": "an IPv6 entry in long form", "host": "2001:db8::1", "excluded": ["2001:0DB8:0000::0001"], "result": true},
    {"name": "another IPv6", "host": "2001:db8::2", "excluded": ["2001:db8::1"], "result": false},
    {"name": "an IPv6 CIDR", "host": "2001:db8:1::5", "excluded": ["2001:db8::/32"], "result": true},
    {"name": "outside an IPv6 CIDR", "host": "2001:db9::5", "excluded": ["2001:db8::/32"], "result": false},
    {"name": "an IPv6 URL host", "host": "http://[2001:db8::1]:8080/", "excluded": ["2001:db8::/64"], "result": true},
    {"name": "an IPv6 with an embedded IPv4 tail", "host": "::ffff:10.0.0.5", "excluded": ["::ffff:10.0.0.0/104"], "result": true},
    {"name": "an IPv4-mapped IPv6 is not the IPv4", "host": "::ffff:10.0.0.5", "excluded": ["10.0.0.0/8"], "result": false},
    {"name": "an IPv4 is not in an IPv6 network", "host": "10.0.0.5", "excluded": ["::/0"], "result": false},
    {"name": "an IPv6 zone is ignored by a CIDR", "host": "fe80::1%eth0", "excluded": ["fe80::/10"], "result": true},
    {"name": "a malformed IPv6 is not an IP", "host": "2001:db8:::1", "excluded": ["2001:db8::/32"], "result": false},
    {"name": "a later entry still matches", "host": "pay.example.com", "excluded": ["other.test", "10.0.0.0/8", "pay.example.com"], "result": true},
    {"name": "non-string and empty entries are skipped", "host": "a.example.com", "excluded": [null, 5, "", "   ", "example.com"], "result": true},
    {"name": "no exclusions excludes nothing", "host": "a.example.com", "excluded": [], "result": false},
    {"name": "an empty host is never excluded", "host": "", "excluded": ["example.com"], "result": false},
    {"name": "a missing host is never excluded", "host": null, "excluded": ["example.com"], "result": false},
    {"name": "a recording wildcard under an excluded domain", "host": "*.example.com", "excluded": ["example.com"], "result": true},
    {"name": "a recording wildcard is not excluded by one of its subdomains", "host": "*.example.com", "excluded": ["api.example.com"], "result": false},
    {"name": "a host entry with a trailing slash excludes its host", "host": "admin.example.com", "excluded": ["admin.example.com/"], "result": true},
    {"name": "a host entry with a path excludes its host", "host": "admin.example.com", "excluded": ["admin.example.com/login"], "result": true},
    {"name": "a host entry with a path excludes its subdomains like a domain", "host": "x.admin.example.com", "excluded": ["admin.example.com/login"], "result": true},
    {"name": "a host entry with a path does not exclude a sibling", "host": "www.example.com", "excluded": ["admin.example.com/login"], "result": false},
    {"name": "a host entry with a port and a path", "host": "admin.example.com", "excluded": ["Admin.Example.com.:8443/login?next=/"], "result": true},
    {"name": "a host entry with a numeric path is not a CIDR", "host": "example.com", "excluded": ["example.com/24"], "result": true},
    {"name": "a URL entry with a trailing slash", "host": "admin.example.com", "excluded": ["https://admin.example.com/"], "result": true},
    {"name": "a wildcard entry with a path", "host": "a.example.com", "excluded": ["*.example.com/admin"], "result": true},
    {"name": "a wildcard entry with a path still spares its apex", "host": "example.com", "excluded": ["*.example.com/admin"], "result": false},
    {"name": "an IPv4 with a trailing slash", "host": "192.0.2.10", "excluded": ["192.0.2.10/"], "result": true},
    {"name": "an IPv4 with a path", "host": "192.0.2.10", "excluded": ["192.0.2.10/admin"], "result": true},
    {"name": "an IPv4 with a path is not a network", "host": "192.0.2.11", "excluded": ["192.0.2.10/admin"], "result": false},
    {"name": "a bracketed IPv6 with a path", "host": "2001:db8::1", "excluded": ["[2001:db8::1]:443/admin"], "result": true},
    {"name": "a bare IPv6 with a path", "host": "2001:db8::1", "excluded": ["2001:db8::1/admin"], "result": true},
    {"name": "a prefix that is too long is not an exact IP either", "host": "10.0.0.0", "excluded": ["10.0.0.0/33"], "result": false},
    {"name": "a malformed bracket entry is skipped, not fatal", "host": "a.example.com", "excluded": ["https://[a.example.com/", "https://[a.example.com]/", "//[bad/x", "a.example.com"], "result": true},
    {"name": "a malformed bracket entry excludes nothing", "host": "a.example.com", "excluded": ["https://[a.example.com]/", "[a.example.com/x"], "result": false},
    {"name": "a malformed bracket host is never excluded", "host": "https://[a.example.com/", "excluded": ["a.example.com"], "result": false}
  ]
}
