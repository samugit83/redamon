{
  "_comment": "Shared vectors for the RoE half of a partial run's typed-input filter (R-6): recon/partial_recon_modules/helpers.py filter_partial_user_input (recon/tests/test_partial_typed_input_roe.py) and its orchestrator copy recon_orchestrator/batch_scope.py filter_partial_user_input (recon_orchestrator/tests/test_partial_typed_input_roe.py). Domain vectors run on one enumerate group, example.com with its root in scope; IP vectors on targets 192.0.2.10 and 192.0.2.11. 'kept' lists only the keys the vector checks; 'roe_refused' counts the refusals that name the Rules of Engagement. 'resolved' is the DNS both filters see (a name it does not list has no address); with 'no_lookup' nothing may be resolved. Under RoE IP or CIDR entries a typed name passes only when every address it resolves to is admitted (D2); 'orchestrator' overrides the verdict for the orchestrator's copy, which resolves from outside the scan's network and so leaves a name it gets no answer for to the container. 'hostname' is an IP-mode project's hostname policy (mode, include, exclude; absent means IP only): a typed name passes the pattern half of the rule and the RoE here and is never resolved, as both copies leave the DNS half to the container's live check (ip_hostname_scope). Reserved names and documentation ranges only.",
  "vectors": [
    {"name": "an excluded typed subdomain is dropped",
     "excluded": ["legacy.example.com"],
     "typed": {"subdomains": ["legacy.example.com", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 1},
    {"name": "a domain exclusion drops its subdomains from the flat list",
     "excluded": ["old.example.com"],
     "typed": {"user_inputs": ["a.old.example.com", "api.example.com"]},
     "kept": {"user_inputs": ["api.example.com"]}, "roe_refused": 1},
    {"name": "a wildcard exclusion keeps its apex",
     "excluded": ["*.shop.example.com"],
     "typed": {"subdomains": ["shop.example.com", "x.shop.example.com"]},
     "kept": {"subdomains": ["shop.example.com"]}, "roe_refused": 1},
    {"name": "an exclusion with a scheme and a port excludes its host",
     "excluded": ["https://legacy.example.com:8443/"],
     "typed": {"subdomains": ["legacy.example.com"]},
     "kept": {"subdomains": []}, "roe_refused": 1},
    {"name": "case and a trailing dot are ignored",
     "excluded": ["Legacy.Example.com."],
     "typed": {"subdomains": ["LEGACY.example.com"]},
     "kept": {"subdomains": []}, "roe_refused": 1},
    {"name": "an excluded URL host is dropped",
     "excluded": ["legacy.example.com"],
     "typed": {"urls": ["https://legacy.example.com/login", "https://www.example.com/"]},
     "kept": {"urls": ["https://www.example.com/"]}, "roe_refused": 1},
    {"name": "an exclusion with a path excludes its whole host",
     "excluded": ["admin.example.com/login"],
     "typed": {"urls": ["https://admin.example.com/other", "https://api.example.com/v1"]},
     "kept": {"urls": ["https://api.example.com/v1"]}, "roe_refused": 1},
    {"name": "an out-of-scope host is a scope refusal, not an RoE one",
     "excluded": ["legacy.example.com"],
     "typed": {"subdomains": ["evil.test", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 0},
    {"name": "an excluded typed IP is dropped",
     "excluded": ["192.0.2.10"],
     "typed": {"ips": ["192.0.2.10", "192.0.2.11"]},
     "kept": {"ips": ["192.0.2.11"]}, "roe_refused": 1},
    {"name": "an excluded CIDR drops an address inside it",
     "excluded": ["192.0.2.0/28"],
     "typed": {"ips": ["192.0.2.5", "192.0.2.20"]},
     "kept": {"ips": ["192.0.2.20"]}, "roe_refused": 1},
    {"name": "a netmask exclusion drops an address inside it",
     "excluded": ["192.0.2.0/255.255.255.240"],
     "typed": {"ips": ["192.0.2.3", "192.0.2.17"]},
     "kept": {"ips": ["192.0.2.17"]}, "roe_refused": 1},
    {"name": "a typed CIDR inside an excluded CIDR is dropped",
     "excluded": ["192.0.2.0/24"],
     "typed": {"ips": ["192.0.2.0/28", "198.51.100.0/30"]},
     "kept": {"ips": ["198.51.100.0/30"]}, "roe_refused": 1},
    {"name": "a typed CIDR around an excluded address keeps its other hosts",
     "excluded": ["192.0.2.2"],
     "typed": {"ips": ["192.0.2.0/29", "198.51.100.7"]},
     "kept": {"ips": ["192.0.2.1", "192.0.2.3", "192.0.2.4", "192.0.2.5", "192.0.2.6", "198.51.100.7"]},
     "roe_refused": 1},
    {"name": "a typed CIDR clear of every exclusion is kept whole",
     "excluded": ["192.0.2.100", "legacy.example.com"],
     "typed": {"ips": ["192.0.2.0/29"]},
     "kept": {"ips": ["192.0.2.0/29"]}, "roe_refused": 0},
    {"name": "an IPv6 address matches in any spelling",
     "excluded": ["2001:db8::5"],
     "typed": {"ips": ["2001:db8:0:0:0:0:0:5", "2001:db8::6"]},
     "kept": {"ips": ["2001:db8::6"]}, "roe_refused": 1},
    {"name": "a domain exclusion never matches an IP",
     "excluded": ["example.com"],
     "typed": {"ips": ["192.0.2.1"], "subdomains": ["www.example.com"]},
     "kept": {"ips": ["192.0.2.1"], "subdomains": []}, "roe_refused": 1},
    {"name": "an excluded attach target is cleared",
     "excluded": ["legacy.example.com"],
     "typed": {"ips": ["192.0.2.1"], "ip_attach_to": "legacy.example.com",
               "urls": ["https://www.example.com/"], "url_attach_to": "https://legacy.example.com"},
     "kept": {"ips": ["192.0.2.1"], "ip_attach_to": null,
              "urls": ["https://www.example.com/"], "url_attach_to": null},
     "roe_refused": 2},
    {"name": "with no exclusion nothing is dropped",
     "excluded": [],
     "typed": {"user_inputs": ["legacy.example.com"], "subdomains": ["legacy.example.com"],
               "urls": ["https://legacy.example.com/"], "ips": ["192.0.2.10", "192.0.2.0/29"],
               "url_attach_to": "https://legacy.example.com"},
     "kept": {"user_inputs": ["legacy.example.com"], "subdomains": ["legacy.example.com"],
              "urls": ["https://legacy.example.com/"], "ips": ["192.0.2.10", "192.0.2.0/29"],
              "url_attach_to": "https://legacy.example.com"},
     "roe_refused": 0},
    {"name": "IP mode: a URL on an excluded target address is dropped",
     "ip_mode": true,
     "excluded": ["192.0.2.10"],
     "typed": {"urls": ["http://192.0.2.10:8080/", "http://192.0.2.11/"], "ips": ["192.0.2.10", "192.0.2.11"]},
     "kept": {"urls": ["http://192.0.2.11/"], "ips": ["192.0.2.11"]}, "roe_refused": 2},
    {"name": "IP mode: a typed CIDR inside an excluded range is dropped",
     "ip_mode": true,
     "excluded": ["192.0.2.0/24"],
     "typed": {"ips": ["192.0.2.8/30"]},
     "kept": {"ips": []}, "roe_refused": 1},
    {"name": "a typed name resolving only into an excluded CIDR is dropped",
     "excluded": ["198.51.100.0/24"],
     "resolved": {"legacy.example.com": ["198.51.100.20"], "www.example.com": ["192.0.2.7"]},
     "typed": {"subdomains": ["legacy.example.com", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 1},
    {"name": "a typed name with one excluded address is refused whole",
     "excluded": ["198.51.100.0/24"],
     "resolved": {"mixed.example.com": ["192.0.2.8", "198.51.100.21"], "www.example.com": ["192.0.2.7"]},
     "typed": {"subdomains": ["mixed.example.com", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 1},
    {"name": "the flat list is checked on its addresses too",
     "excluded": ["198.51.100.20"],
     "resolved": {"legacy.example.com": ["198.51.100.20"], "api.example.com": ["192.0.2.9"]},
     "typed": {"user_inputs": ["legacy.example.com", "api.example.com"]},
     "kept": {"user_inputs": ["api.example.com"]}, "roe_refused": 1},
    {"name": "a URL whose host resolves into an excluded CIDR is dropped",
     "excluded": ["198.51.100.0/24"],
     "resolved": {"legacy.example.com": ["198.51.100.20"], "www.example.com": ["192.0.2.7"]},
     "typed": {"urls": ["https://legacy.example.com/login", "https://www.example.com/"]},
     "kept": {"urls": ["https://www.example.com/"]}, "roe_refused": 1},
    {"name": "an IPv6 answer inside an excluded range refuses its name",
     "excluded": ["2001:db8::/64"],
     "resolved": {"v6.example.com": ["192.0.2.12", "2001:db8:0:0:0:0:0:5"], "www.example.com": ["192.0.2.7"]},
     "typed": {"subdomains": ["v6.example.com", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 1},
    {"name": "an attach name resolving into an excluded CIDR is cleared, its IPs kept",
     "excluded": ["198.51.100.0/24"],
     "resolved": {"legacy.example.com": ["198.51.100.20"]},
     "typed": {"ips": ["192.0.2.30"], "ip_attach_to": "legacy.example.com"},
     "kept": {"ips": ["192.0.2.30"], "ip_attach_to": null}, "roe_refused": 1},
    {"name": "a name with no address is refused while IP exclusions are set",
     "excluded": ["198.51.100.0/24"],
     "resolved": {"www.example.com": ["192.0.2.7"]},
     "typed": {"subdomains": ["ghost.example.com", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 1,
     "orchestrator": {"kept": {"subdomains": ["ghost.example.com", "www.example.com"]}, "roe_refused": 0}},
    {"name": "names are not resolved when no IP or CIDR is excluded",
     "excluded": ["legacy.example.com"],
     "resolved": {},
     "typed": {"subdomains": ["www.example.com"], "urls": ["https://api.example.com/"],
               "ips": ["192.0.2.1"], "ip_attach_to": "www.example.com"},
     "kept": {"subdomains": ["www.example.com"], "urls": ["https://api.example.com/"],
              "ip_attach_to": "www.example.com"},
     "roe_refused": 0, "no_lookup": true},
    {"name": "an out-of-scope or name-excluded host is never resolved",
     "excluded": ["198.51.100.0/24", "legacy.example.com"],
     "resolved": {},
     "typed": {"subdomains": ["evil.test", "legacy.example.com"]},
     "kept": {"subdomains": []}, "roe_refused": 1, "no_lookup": true},
    {"name": "a URL attach target is a graph link and is not resolved",
     "excluded": ["198.51.100.0/24"],
     "resolved": {"www.example.com": ["192.0.2.7"]},
     "typed": {"urls": ["https://www.example.com/"], "url_attach_to": "https://ghost.example.com"},
     "kept": {"urls": ["https://www.example.com/"], "url_attach_to": "https://ghost.example.com"},
     "roe_refused": 0},
    {"name": "IP mode: a typed name is a scope refusal and is never resolved",
     "ip_mode": true,
     "excluded": ["198.51.100.0/24"],
     "resolved": {},
     "typed": {"subdomains": ["www.example.com"], "urls": ["http://www.example.com/", "http://192.0.2.10/"],
               "ips": ["192.0.2.10"]},
     "kept": {"subdomains": [], "urls": ["http://192.0.2.10/"], "ips": ["192.0.2.10"]},
     "roe_refused": 0, "no_lookup": true},
    {"name": "IP mode, Record hostnames: every typed name is refused",
     "ip_mode": true, "hostname": {"mode": "record_only"},
     "excluded": [],
     "typed": {"user_inputs": ["api.example.com"], "subdomains": ["www.example.com"],
               "urls": ["https://www.example.com/", "http://192.0.2.10/"]},
     "kept": {"user_inputs": [], "subdomains": [], "urls": ["http://192.0.2.10/"]},
     "roe_refused": 0, "no_lookup": true},
    {"name": "IP mode, Record + scan matching: the include and exclude entries decide, unresolved",
     "ip_mode": true, "hostname": {"mode": "record_filter", "include": ["*.example.com"],
                                   "exclude": ["old.example.com"]},
     "excluded": ["198.51.100.0/24"],
     "resolved": {"www.example.com": ["198.51.100.7"]},
     "typed": {"user_inputs": ["WWW.Example.com."],
               "subdomains": ["www.example.com", "old.example.com", "www.example.net"],
               "urls": ["https://api.example.com/x", "https://www.example.net/"]},
     "kept": {"user_inputs": ["www.example.com"], "subdomains": ["www.example.com"],
              "urls": ["https://api.example.com/x"]},
     "roe_refused": 0, "no_lookup": true},
    {"name": "IP mode, Record + scan all: any name, never a hard-blocked one",
     "ip_mode": true, "hostname": {"mode": "scan_all"},
     "excluded": [],
     "typed": {"subdomains": ["www.example.net", "www.example.gov"]},
     "kept": {"subdomains": ["www.example.net"]},
     "roe_refused": 0, "no_lookup": true},
    {"name": "IP mode, Record + scan matching: a name the RoE excludes is the RoE's refusal",
     "ip_mode": true, "hostname": {"mode": "record_filter", "include": ["*.example.com"]},
     "excluded": ["www.example.com"],
     "typed": {"subdomains": ["www.example.com", "api.example.com"]},
     "kept": {"subdomains": ["api.example.com"]},
     "roe_refused": 1, "no_lookup": true}
  ]
}
