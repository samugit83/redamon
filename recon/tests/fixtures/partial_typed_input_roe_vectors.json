{
  "_comment": "Shared vectors for the RoE half of a partial run's typed-input filter (R-6): recon/partial_recon_modules/helpers.py filter_partial_user_input (recon/tests/test_partial_typed_input_roe.py) and its orchestrator copy recon_orchestrator/batch_scope.py filter_partial_user_input (recon_orchestrator/tests/test_partial_typed_input_roe.py). Domain vectors run on one enumerate group, example.com with its root in scope; IP vectors on targets 192.0.2.10 and 192.0.2.11. 'kept' lists only the keys the vector checks; 'roe_refused' counts the refusals that name the Rules of Engagement. Reserved names and documentation ranges only.",
  "vectors": [
    {"name": "an excluded typed subdomain is dropped",
     "excluded": ["legacy.example.com"],
     "typed": {"subdomains": ["legacy.example.com", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 1},
    {"name": "a domain exclusion drops its subdomains from the flat list",
     "excluded": ["old.example.com"],
     "typed": {"user_inputs": ["a.old.example.com", "api.example.com"]},
     "kept": {"user_inputs": ["api.example.com"]}, "roe_refused": 1},
    {"name": "a wildcard exclusion keeps its apex",
     "excluded": ["*.shop.example.com"],
     "typed": {"subdomains": ["shop.example.com", "x.shop.example.com"]},
     "kept": {"subdomains": ["shop.example.com"]}, "roe_refused": 1},
    {"name": "an exclusion with a scheme and a port excludes its host",
     "excluded": ["https://legacy.example.com:8443/"],
     "typed": {"subdomains": ["legacy.example.com"]},
     "kept": {"subdomains": []}, "roe_refused": 1},
    {"name": "case and a trailing dot are ignored",
     "excluded": ["Legacy.Example.com."],
     "typed": {"subdomains": ["LEGACY.example.com"]},
     "kept": {"subdomains": []}, "roe_refused": 1},
    {"name": "an excluded URL host is dropped",
     "excluded": ["legacy.example.com"],
     "typed": {"urls": ["https://legacy.example.com/login", "https://www.example.com/"]},
     "kept": {"urls": ["https://www.example.com/"]}, "roe_refused": 1},
    {"name": "an exclusion with a path excludes its whole host",
     "excluded": ["admin.example.com/login"],
     "typed": {"urls": ["https://admin.example.com/other", "https://api.example.com/v1"]},
     "kept": {"urls": ["https://api.example.com/v1"]}, "roe_refused": 1},
    {"name": "an out-of-scope host is a scope refusal, not an RoE one",
     "excluded": ["legacy.example.com"],
     "typed": {"subdomains": ["evil.test", "www.example.com"]},
     "kept": {"subdomains": ["www.example.com"]}, "roe_refused": 0},
    {"name": "an excluded typed IP is dropped",
     "excluded": ["192.0.2.10"],
     "typed": {"ips": ["192.0.2.10", "192.0.2.11"]},
     "kept": {"ips": ["192.0.2.11"]}, "roe_refused": 1},
    {"name": "an excluded CIDR drops an address inside it",
     "excluded": ["192.0.2.0/28"],
     "typed": {"ips": ["192.0.2.5", "192.0.2.20"]},
     "kept": {"ips": ["192.0.2.20"]}, "roe_refused": 1},
    {"name": "a netmask exclusion drops an address inside it",
     "excluded": ["192.0.2.0/255.255.255.240"],
     "typed": {"ips": ["192.0.2.3", "192.0.2.17"]},
     "kept": {"ips": ["192.0.2.17"]}, "roe_refused": 1},
    {"name": "a typed CIDR inside an excluded CIDR is dropped",
     "excluded": ["192.0.2.0/24"],
     "typed": {"ips": ["192.0.2.0/28", "198.51.100.0/30"]},
     "kept": {"ips": ["198.51.100.0/30"]}, "roe_refused": 1},
    {"name": "a typed CIDR around an excluded address keeps its other hosts",
     "excluded": ["192.0.2.2"],
     "typed": {"ips": ["192.0.2.0/29", "198.51.100.7"]},
     "kept": {"ips": ["192.0.2.1", "192.0.2.3", "192.0.2.4", "192.0.2.5", "192.0.2.6", "198.51.100.7"]},
     "roe_refused": 1},
    {"name": "a typed CIDR clear of every exclusion is kept whole",
     "excluded": ["192.0.2.100", "legacy.example.com"],
     "typed": {"ips": ["192.0.2.0/29"]},
     "kept": {"ips": ["192.0.2.0/29"]}, "roe_refused": 0},
    {"name": "an IPv6 address matches in any spelling",
     "excluded": ["2001:db8::5"],
     "typed": {"ips": ["2001:db8:0:0:0:0:0:5", "2001:db8::6"]},
     "kept": {"ips": ["2001:db8::6"]}, "roe_refused": 1},
    {"name": "a domain exclusion never matches an IP",
     "excluded": ["example.com"],
     "typed": {"ips": ["192.0.2.1"], "subdomains": ["www.example.com"]},
     "kept": {"ips": ["192.0.2.1"], "subdomains": []}, "roe_refused": 1},
    {"name": "an excluded attach target is cleared",
     "excluded": ["legacy.example.com"],
     "typed": {"ips": ["192.0.2.1"], "ip_attach_to": "legacy.example.com",
               "urls": ["https://www.example.com/"], "url_attach_to": "https://legacy.example.com"},
     "kept": {"ips": ["192.0.2.1"], "ip_attach_to": null,
              "urls": ["https://www.example.com/"], "url_attach_to": null},
     "roe_refused": 2},
    {"name": "with no exclusion nothing is dropped",
     "excluded": [],
     "typed": {"user_inputs": ["legacy.example.com"], "subdomains": ["legacy.example.com"],
               "urls": ["https://legacy.example.com/"], "ips": ["192.0.2.10", "192.0.2.0/29"],
               "url_attach_to": "https://legacy.example.com"},
     "kept": {"user_inputs": ["legacy.example.com"], "subdomains": ["legacy.example.com"],
              "urls": ["https://legacy.example.com/"], "ips": ["192.0.2.10", "192.0.2.0/29"],
              "url_attach_to": "https://legacy.example.com"},
     "roe_refused": 0},
    {"name": "IP mode: a URL on an excluded target address is dropped",
     "ip_mode": true,
     "excluded": ["192.0.2.10"],
     "typed": {"urls": ["http://192.0.2.10:8080/", "http://192.0.2.11/"], "ips": ["192.0.2.10", "192.0.2.11"]},
     "kept": {"urls": ["http://192.0.2.11/"], "ips": ["192.0.2.11"]}, "roe_refused": 2},
    {"name": "IP mode: a typed CIDR inside an excluded range is dropped",
     "ip_mode": true,
     "excluded": ["192.0.2.0/24"],
     "typed": {"ips": ["192.0.2.8/30"]},
     "kept": {"ips": []}, "roe_refused": 1}
  ]
}
