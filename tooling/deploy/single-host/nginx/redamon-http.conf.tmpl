# RedAmon single public origin -- HTTP-only template (ACCESS_MODE=http-domain | http-ip)
# --------------------------------------------------------------------------------------
# LAB/TEST ONLY. No TLS: plaintext cookies/creds, no HSTS, agent WS over plain ws://.
# deploy.sh only renders this behind ALLOW_INSECURE=1 and a loud banner. The single-origin
# funnel, the WS session gate (auth_request), the trust-header stripping, the method filter
# and the ip-allowlist gate are all PRESERVED -- only transport encryption is gone. With no
# TLS the gate is the PRIMARY control, not defense-in-depth.
#
# Tokens: __SERVER_NAME__ __CSP_CONNECT__ __GATE__ __MCP_GATE__ __HTTP_PORT__ __CSP_HEADER_NAME__
#         __WS_AUTH_REQUEST__

map $http_upgrade $connection_upgrade { default upgrade; '' close; }
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m   rate=30r/s;
# Inbound MCP server. Present in the HTTP template too so a request never falls
# through to `location /api/` and consumes the UI's budget -- even though
# deploy.sh REFUSES to enable MCP in http-* modes (a bearer token would cross
# the wire in plaintext on every call). If the flag is ever set by hand on the
# host, this keeps the endpoint correctly scoped rather than silently mis-routed.
limit_req_zone $binary_remote_addr zone=mcp:10m   rate=10r/s;
limit_conn_zone $binary_remote_addr zone=conn:10m;
# server_tokens is set per-server (below), NOT at http level -- avoids a fatal
# "duplicate directive" when the base nginx.conf http{} already declares one.

server {
    listen __HTTP_PORT__;
    listen [::]:__HTTP_PORT__;
    server_name __SERVER_NAME__;
    server_tokens off;

    include /etc/nginx/snippets/redamon-security-headers.conf;
    add_header __CSP_HEADER_NAME__ "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' __CSP_CONNECT__; worker-src 'self' blob:; manifest-src 'self'" always;

    limit_conn conn 20;
    client_body_timeout 15s; client_header_timeout 15s; send_timeout 15s; keepalive_timeout 20s;
    large_client_header_buffers 8 32k;
    # Compress JSON. Ubuntu's stock nginx.conf ships `gzip on` with EVERY
    # gzip_types line commented out, so only text/html was compressed and the
    # graph payload -- highly repetitive JSON, typically 5-10x -- crossed the wire
    # raw. Set at server level so the base nginx.conf stays untouched.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css text/plain
               text/javascript application/xml image/svg+xml;

    client_max_body_size 60m;
    autoindex off;

    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) { return 405; }

    # __GATE__

    location = /_redamon_session {
        internal;
        proxy_pass http://127.0.0.1:3000/api/auth/me;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Internal-Key "";
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
    }

    location ~ ^/ws/(agent|kali-terminal|cypherfix-triage|cypherfix-codefix)$ {
        __WS_AUTH_REQUEST__
        limit_conn conn 20;
        include /etc/nginx/snippets/redamon-proxy-common.conf;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s; proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /api/auth/login {
        limit_req zone=login burst=3 nodelay; limit_req_status 429;
        include /etc/nginx/snippets/redamon-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        add_header Cache-Control "no-store" always;
    }
    # EXACT match: a prefix block written `/api/mcp-server/` does NOT match the
    # endpoint URL `/api/mcp-server`, and the request would fall through to
    # `location /api/` below with the UI rate zone and the server's gate.
    location = /api/mcp-server {
        limit_req zone=mcp burst=20 nodelay; limit_req_status 429;
        limit_req_log_level warn;
        client_max_body_size 64k;
        # __MCP_GATE__
        include /etc/nginx/snippets/redamon-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
        proxy_read_timeout 3600s; proxy_buffering off;
        # Re-stated via the shared snippet (a location with any add_header stops
        # inheriting the server-level set). No HSTS here: this template is the
        # plaintext one.
        include /etc/nginx/snippets/redamon-security-headers-only.conf;
        add_header __CSP_HEADER_NAME__ "default-src 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store" always;
    }
    # Plugin-internal routes: the Gateway that plugin code calls (call-token auth), the
    # runner's run list (runner key) and plugin reconciliation (internal key). They are
    # reached only on the container networks; from the public edge they would offer an
    # attacker those credentials' checks to probe, and nginx does not strip the headers
    # they authenticate with. `^~` wins over every regex location, and nginx matches the
    # decoded, slash-merged path, so `%70lugin-gateway` or `//` variants land here too.
    location ^~ /api/plugin-gateway/ { return 404; }
    location ^~ /api/plugin-runner/ { return 404; }
    location ^~ /api/internal/plugins/ { return 404; }
    # Internal-only routes (NF-13, F-23): every /api/internal/ route answers only the
    # internal or scanner key, the tunnel credentials only the internal key, the tunnel
    # sync only the kali-sandbox's bearer. Their callers (orchestrator, agent, sandbox,
    # capture ingest) use the container network names, never this edge. The longest
    # prefix wins, so /api/internal/plugins/ above keeps its own deny.
    location ^~ /api/internal/ { return 404; }
    location = /api/global/tunnel-config { return 404; }
    location ^~ /api/global/tunnel-config/ { return 404; }
    location /api/ {
        limit_req zone=api burst=60 nodelay; limit_req_status 429;
        include /etc/nginx/snippets/redamon-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
        proxy_read_timeout 3600s; proxy_buffering off;
    }
    location / {
        include /etc/nginx/snippets/redamon-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
