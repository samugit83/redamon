# ============================================================================
#  RedAmon single-host deploy config  --  cp .env.example .env  then edit
# ----------------------------------------------------------------------------
#  This is the deploy-TIME config for the operator's LOCAL machine. It is NOT the
#  application .env that redamon.sh generates on the server. Keep real .env* files
#  local and gitignored. A run is just:  ./deploy.sh init
#  CLI positionals override the connection fields:  ./deploy.sh init <IP> <AUTH> <USER>
# ============================================================================

# ============================================================================
#  CONNECTION -- how deploy.sh reaches the box (CLI positionals override these)
# ============================================================================
HOST_IP=                                   # public IP or DNS of the target server (required)
REMOTE_USER=ubuntu                          # ssh sudoer (ubuntu / admin / root-capable)
SSH_KEY_PATH=~/.ssh/redamon.pem             # key auth (recommended). LOCAL-only; never copied to host
SSH_PASSWORD=                               # password-auth fallback; needs local sshpass. Discouraged
SSH_PORT=22                                 # non-standard SSH port if the host moved it

# ============================================================================
#  REPO -- public, no auth token required
# ============================================================================
REPO_URL=https://github.com/samugit83/redamon.git
REPO_BRANCH=master                          # branch to deploy
APP_DIR=redamon                             # stable checkout dir -> stable COMPOSE_PROJECT_NAME (DB-volume detection)
REDAMON_VERSION=                            # optional image/version stamp; blank -> redamon.sh default

# ============================================================================
#  PUBLIC ACCESS MODE -- the top-level switch for how the UI is exposed
# ----------------------------------------------------------------------------
#   https-domain : TLS on a DNS name        (letsencrypt|provided)  <- recommended / default
#   https-ip     : TLS on a bare IP         (self-signed|provided)  -> browser cert warning
#   http-domain  : plain HTTP on a DNS name (no TLS)                 -> LAB/TEST ONLY, insecure
#   http-ip      : plain HTTP on a bare IP  (no TLS)                 -> LAB/TEST ONLY, most insecure
# ============================================================================
ACCESS_MODE=https-domain
DOMAIN=redamon.example.com                  # required for *-domain modes; ignored for *-ip modes
HTTP_PORT=80                                # nginx listen + ufw. Keep 80 for Let's Encrypt (http-01 uses 80)
HTTPS_PORT=443                              # nginx listen + ufw. Change only when fronted by an LB presenting 443

# --- TLS (consulted only for https-* modes) ---
TLS_MODE=letsencrypt                        # letsencrypt (domain only) | provided | self-signed (ip only)
LETSENCRYPT_EMAIL=ops@example.com           # certbot registration/expiry mail (required for letsencrypt)
LETSENCRYPT_STAGING=false                   # true = LE staging cert while testing (dodges the rate limit)
SSL_CERT_LOCAL=cert/fullchain.pem           # provided mode: local paths (relative to this dir), SCP'd to host
SSL_KEY_LOCAL=cert/privkey.pem
SSL_KEY_PASSWORD=                           # if the provided key is encrypted
HSTS_ENABLE=true                            # https-only; auto-absent for http-* modes

# ============================================================================
#  ACCESS CONTROL / HOST HARDENING (defense-in-depth)
# ============================================================================
OPERATOR_ALLOW_CIDRS=203.0.113.10/32        # comma list: nginx allow gate + ufw 443 source (strongly recommended)
SSH_ALLOW_CIDRS=                            # comma list for ufw :22; blank -> falls back to OPERATOR_ALLOW_CIDRS
GATE_MODE=ip_allowlist                       # ip_allowlist | basic_auth | none
BASIC_AUTH_USER=                            # basic_auth mode only
BASIC_AUTH_PASS=
WS_REQUIRE_SESSION=true                      # nginx auth_request: require a valid webapp session
                                            # before ANY /ws/* upgrade. Keep true - 3 of the 4 agent
                                            # WS paths are unauthenticated (incl. a root PTY).
CSP_ENFORCE=false                            # false = Content-Security-Policy-Report-Only (safe default);
                                            # true = enforced CSP (promote after verifying graph+terminal render)
ENABLE_UFW=true                             # host firewall
ENABLE_SSH_HARDENING=true                   # key-only + no-root (password login left alone if you used a password)
ENABLE_FAIL2BAN=true                        # sshd + nginx jails
ENABLE_UNATTENDED_UPGRADES=true             # auto security patches

# ============================================================================
#  FEATURE FLAGS (map to redamon.sh install flags)
# ============================================================================
ENABLE_GVM=false                            # --gvm   (heavy; 10-20min feed sync; rotates admin/admin)
ENABLE_KB=false                             # --kbase (bakes ML embedding models; +~4.4GB image) -- the REAL KB switch
ENABLE_KB_REFRESH=false                     # kb-refresh sidecar
ENABLE_ZRAM=true                            # REDAMON_ENABLE_ZRAM compressed-RAM cushion
# NOTE: SKIP_KB is NOT an input -- redamon.sh derives it from the .kbase-enabled flag. Use ENABLE_KB only.

# ============================================================================
#  RESOURCES / HOST TUNING
# ============================================================================
SWAP_PCT=25                                 # swapfile as a % of host RAM, at ANY size (0 = skip).
                                            # 25% is what unlocks the memory governor's higher burst
                                            # factor; below that it stays conservative.
SWAP_SIZE_GB=                               # DEPRECATED explicit override in GB; blank -> use SWAP_PCT

# --- Memory governor: all PERCENTAGES, so one file fits every instance size ---
# redamon.sh sizes every service from the host's RAM and writes the result into a
# managed block in the app .env. Seed the SHARES here, never absolute sizes.
OS_RESERVE_PCT=                             # RAM held back for the kernel/OS (default 8)
SERVICES_PCT=                               # share of the remainder for always-on services (default 65)
BURST_FACTOR=                               # over-commit multiplier for ceiling-type services
                                            # (default 1.75, or 2.5 with enough swap; always clamped
                                            # so the worst case cannot exceed RAM+swap)
BURST_SWAP_MIN_PCT=                         # swap needed, as % of RAM, to unlock 2.5 (default 25)
BLAST_PCT=                                  # no single service above this % of host RAM (default 55)
DISK_RESERVE_PCT=                           # free-disk warning threshold as % of the filesystem (default 10)
REDAMON_WEIGHT_WEBAPP=                      # per-service share overrides, per-mille of the services pool
REDAMON_WEIGHT_NEO4J=
REDAMON_WEIGHT_AGENT=
REDAMON_SKIP_RAM_GATE=false                 # true bypasses redamon.sh's 8GB floor on tiny boxes (risky)
REDAMON_BUILD_PARALLEL=                     # cap concurrent image builds; blank -> redamon.sh auto-size
DOCKER_DNS=                                 # e.g. 8.8.8.8,8.8.4.4 -> /etc/docker/daemon.json if container DNS breaks
DOCKER_BUILD_CACHE_MAX_GB=                  # cap BuildKit cache (GB) via daemon.json auto-GC; blank -> Docker default. install/update already drop the cache each build orphans; this is the second-line ceiling
# Per-service CPU limits (compose `cpus:`) are auto-capped to the host's CPU count at
# init so `up` never fails with "range of CPUs is from 0.01 to N" on a small box.
# Override any explicitly here to pin it (e.g. NEO4J_CPUS=6); blank -> auto min(default, nproc).
# NEO4J_CPUS=  KALI_CPUS=  AGENT_CPUS=  POSTGRES_CPUS=  WEBAPP_CPUS=  RECON_ORCHESTRATOR_CPUS=  DOCKER_BROKER_CPUS=

# ============================================================================
#  ENGAGEMENT / OFFENSIVE KNOBS
# ============================================================================
REVSHELL_TARGET_CIDRS=                      # RoE target scope for './deploy.sh revshell-open' (per-engagement
                                            # 4444 exposure via a host socat forwarder + ufw). Empty = 4444 closed
TUNNELS_ENABLED=false                       # keep off on an already-exposed host

# ============================================================================
#  INBOUND MCP SERVER  (external AI agents connect IN and act as one user)
# ============================================================================
# OFF by default. This is a credentialed, machine-facing endpoint on the SAME
# public port as the UI (/api/mcp-server), so it is switched on deliberately.
# Tokens are minted per user in the UI: Global Settings -> MCP Access Tokens.
MCP_SERVER_ENABLED=false

# THREE gates sit in front of it, and ALL THREE must admit the agent:
#   1. the cloud Security Group (outside this file)
#   2. ufw on the app port          -> MCP_CLIENT_CIDRS (below)
#   3. the nginx location           -> MCP_CLIENT_CIDRS + MCP_EDGE_ALLOW_BEARER
#
# MCP_CLIENT_CIDRS: where your AGENT connects FROM. Required whenever
# OPERATOR_ALLOW_CIDRS is set, because the firewall filters by PORT and cannot
# see the URL path: without it, ufw drops the agent before nginx is ever
# consulted, and MCP_EDGE_ALLOW_BEARER alone changes nothing. These CIDRs are
# admitted to the port, then narrowed by nginx to /api/mcp-server ONLY -- they
# do not gain the UI, the login page or the agent WS paths.
MCP_CLIENT_CIDRS=                           # e.g. 198.51.100.0/24 (your agent's egress)
# IPv6 NOTE (applies to OPERATOR_ALLOW_CIDRS too): nginx listens dual-stack, but
# an IPv4 CIDR does not match an IPv6 client, so an agent that connects over
# IPv6 hits `deny all` and sees 403. Add its IPv6 range as well, or force the
# client to IPv4.

# GATE_MODE=basic_auth is MUTUALLY EXCLUSIVE with bearer auth: it consumes the
# Authorization header, and a client cannot send Basic and Bearer at once. Under
# basic_auth the endpoint returns 403 until you set this, which emits
# `auth_basic off` for that one location, leaving the token as its sole guard.
MCP_EDGE_ALLOW_BEARER=false

# Tuning. Blank -> the app's documented defaults; only pin what you need.
MCP_TOKEN_RETENTION_DAYS=                   # keep dead token rows this long (default 90)
MCP_LLM_DAILY_BUDGET=                       # NL queries per token per day (default 200)
MCP_RATE_READ_PER_MIN=                      # cheap reads per token (default 120)
MCP_RATE_COMPARE_PER_WINDOW=                 # compare_scan_versions per project (default 2)
MCP_RATE_COMPARE_WINDOW_MS=                  # that window (default 300000, 5 min)
MCP_KALI_EXEC_ENABLED=true                   # kali_exec/output/cancel. Separate from the server switch; false withdraws it
MCP_RATE_EXEC_PER_MIN=                       # kali_exec calls per token (default 20)
MCP_DISABLED_TOOLS=                          # comma-separated tool names to withdraw; empty = all served
MCP_RATE_QUERY_PER_MIN=                     # query_graph per token (default 20)
MCP_RATE_WRITE_PER_MIN=                     # settings/stop per token (default 10)
MCP_RATE_MUTE_PER_MIN=                      # mute/unmute calls per token (default 200)
MCP_RATE_START_PER_WINDOW=                  # scan starts per PROJECT (default 1)
MCP_RATE_START_WINDOW_MS=                   # that window (default 300000 = 5 min)
MCP_TOKEN_PRUNE_INTERVAL=                   # seconds between prune sweeps (default 86400)

# Agent in the Loop: your own Claude Code / Codex answers the agent's model calls
# over the MCP server, for projects whose agent model is "Agent in the Loop".
# ON by default; inert unless MCP_SERVER_ENABLED=true (off by default here).
AGENT_IN_THE_LOOP_ENABLED=true
MCP_RATE_LOOP_PER_MIN=                      # loop_* calls per token (default 120)

# Agent Workspace "Import from URL": the server fetches the public URLs a signed-in
# user names (repositories, archives, files, website copies). Private, internal and
# metadata addresses are always refused. Empty keeps it on; false turns it off for
# every user (folder and archive uploads stay). A change reaches the running agent
# on the next `deploy.sh update`.
WORKSPACE_URL_IMPORT_ENABLED=

# NOTE: deploy.sh REFUSES MCP_SERVER_ENABLED=true in http-* ACCESS_MODEs. The
# credential is a bearer token in a header; over plaintext it is broadcast on
# every call and, unlike a session cookie, it outlives the session. In
# https-ip with a self-signed cert most MCP clients reject the certificate --
# use a real cert (TLS_MODE=provided) or a domain.

# ============================================================================
#  PLUGIN PLATFORM  (features installed from the signed redamon-plugins catalog)
# ============================================================================
# Always on: plugin code is third-party code, run in an isolated plugin runner with
# no internet access. It needs Docker Engine 28.0.0 or newer on the server (its
# internal networks use `gateway_mode_ipv4: isolated`); the host bootstrap installs
# Docker from Docker's own repository, and a server that still cannot run the
# platform fails the deploy with the reason. The plugin-internal routes are never
# served by nginx; deploy.sh sets the origin the plugin routes accept from ACCESS_MODE.
# Nothing to set here.

# ============================================================================
#  FIRST ADMIN (required for init -- the first admin user is created automatically)
# ============================================================================
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=                             # at least 12 characters, long and random (init refuses a shorter one)

# ============================================================================
#  OPTIONAL APP CONFIG appended to the server .env (LLM keys are set in the UI, not here)
# ============================================================================
NVD_API_KEY=
KB_EMBEDDING_USE_API=
KB_EMBEDDING_API_BASE_URL=
KB_EMBEDDING_API_KEY=

# Offline OSV database (supply-chain SCA). All blank -> the app defaults: refresh
# on, all eight ecosystems (~280 MB downloaded once, after the tool build), 24h TTL.
# Only pin these on an air-gapped host or to trim the first install.
OSV_DB_AUTO_REFRESH=                        # false on an AIR-GAPPED host (no OSV egress)
OSV_DB_ECOSYSTEMS=                          # e.g. npm,PyPI  -- blank = all 8 (~280 MB)
OSV_DB_TTL_SECONDS=                         # blank -> 86400
OSV_DB_REFRESH_TIMEOUT=                     # blank -> 900

# Supply-chain incident catalog (supplychainattack.org, ~5 MB). Same contract as
# the OSV database above: refreshed TTL-guarded on the scan-spawn path, and a
# failure never blocks a scan. Unlike the OSV DB it MAY populate a cold volume on
# that path, since 5 MB cannot stall a spawn the way a 208 MB download can.
SCA_INTEL_AUTO_REFRESH=                     # false on an AIR-GAPPED host (no feed egress)
SCA_INTEL_TTL_SECONDS=                      # blank -> 86400
SCA_INTEL_RETRY_SECONDS=                    # blank -> 3600 (retry floor after a failed fetch)
SCA_INTEL_REFRESH_TIMEOUT=                  # blank -> 120
SCA_INTEL_BOOTSTRAP_ON_SCAN=                # false = never populate a cold volume on a scan
SCA_INTEL_MATCH_ENABLED=                    # false disables the captured-traffic match (A1)
CAPTURE_IOC_IGNORE_SUFFIXES=                # blank -> the 5 OAST providers in the catalog

# Settings > API Keys > "Check API usage": the webapp calls each provider's
# account/usage endpoint with the saved keys, only when a user clicks it.
API_USAGE_CHECK_ENABLED=                    # false on an AIR-GAPPED host (no provider egress from the webapp)

# ============================================================================
#  DEPLOY BEHAVIOUR / SAFETY
# ============================================================================
INIT_FORCE=false                            # true skips the typed "INIT" wipe confirmation (CI only -- dangerous)
BACKUP_BEFORE_UPDATE=false                  # (reserved) pg_dump + neo4j snapshot before update
DRY_RUN=false                               # print the resolved plan without mutating the host
VERBOSE=false                               # stream full remote command output
ALLOW_INSECURE=0                            # must be 1 to permit http-* modes (they invert the security posture)
